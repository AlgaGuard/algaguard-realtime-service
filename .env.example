NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CONTRACTS_DIR=../algaguard-contracts
KEYCLOAK_ISSUER=http://localhost:8080/realms/algaguard
KEYCLOAK_AUDIENCE=algaguard-api
SERVICE_CLIENT_ID=algaguard-realtime-service
SERVICE_CLIENT_SECRET=replace-with-secret
ACCESS_SERVICE_URL=http://localhost:3001
HTTP_BODY_LIMIT_BYTES=32768
WS_MAX_MESSAGE_BYTES=262144
WS_MAX_SUBSCRIPTIONS=50
WS_OUTBOUND_QUEUE_MAX=100
WS_CONNECTIONS_PER_MINUTE=20
WS_MESSAGES_PER_MINUTE=120
WS_HEARTBEAT_MS=30000
WS_IDLE_TIMEOUT_MS=90000
WS_BACKPRESSURE_BYTES=524288
WS_PREAUTH_BUFFER_MESSAGES=50

